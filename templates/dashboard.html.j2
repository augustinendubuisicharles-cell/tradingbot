<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crypto Signals</title>
<style>
:root {
  --page: #f9f9f7; --surface: #fcfcfb; --raised: #f2f1ec; --ink: #0b0b0b; --ink-2: #52514e; --muted: #6f6d68;
  --grid: #e1e0d9; --track: #ecebe6; --border: rgba(11,11,11,0.10);
  --bar: #2a78d6; --up: #006300; --down: #b42828; --good: #0ca30c; --warn: #fab219; --crit: #d03b3b;
  --good-bg: rgba(12,163,12,0.10); --warn-bg: rgba(250,178,25,0.16); --crit-bg: rgba(208,59,59,0.10);
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --page: #0d0d0d; --surface: #1a1a19; --raised: #232321; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #9a9890;
    --grid: #2c2c2a; --track: #2c2c2a; --border: rgba(255,255,255,0.10);
    --bar: #3987e5; --up: #3fc23f; --down: #f07a7a;
    --good-bg: rgba(12,163,12,0.18); --warn-bg: rgba(250,178,25,0.18); --crit-bg: rgba(240,122,122,0.16);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --page: #0d0d0d; --surface: #1a1a19; --raised: #232321; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #9a9890;
  --grid: #2c2c2a; --track: #2c2c2a; --border: rgba(255,255,255,0.10);
  --bar: #3987e5; --up: #3fc23f; --down: #f07a7a;
  --good-bg: rgba(12,163,12,0.18); --warn-bg: rgba(250,178,25,0.18); --crit-bg: rgba(240,122,122,0.16);
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1080px; margin: 0 auto; padding: 20px 16px 48px; }
h1 { font-size: 22px; margin: 0; letter-spacing: -0.01em; }
h2 { font-size: 16px; margin: 28px 0 10px; }
.sub { color: var(--muted); font-size: 13px; margin: 2px 0 0; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.up { color: var(--up); } .down { color: var(--down); }
.num { font-variant-numeric: tabular-nums; }

/* summary strip */
.strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 16px; }
@media (max-width: 720px) { .strip { grid-template-columns: repeat(2, 1fr); } }
.stat { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; }
.stat .k { color: var(--ink-2); font-size: 12px; }
.stat .v { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.3; }
.stat .n { color: var(--muted); font-size: 12px; }

/* action list */
.actions { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
.act { display: grid; grid-template-columns: auto 1fr auto; gap: 4px 12px; align-items: center;
  padding: 12px 14px; border-bottom: 1px solid var(--grid); }
.act:last-child { border-bottom: 0; }
.act .what { font-size: 14px; }
.act .what b { font-size: 15px; }
.act .lv { color: var(--ink-2); font-size: 13px; font-variant-numeric: tabular-nums; }
@media (max-width: 560px) { .act { grid-template-columns: auto 1fr; } .act .lv { grid-column: 2; } }
.empty { padding: 14px; color: var(--ink-2); }

/* status pills: icon + label, never colour alone */
.pill { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600;
  padding: 2px 9px; border-radius: 999px; white-space: nowrap; border: 1px solid transparent; }
.pill.go { background: var(--good-bg); color: var(--up); }
.pill.wait { background: var(--warn-bg); color: var(--ink); }
.pill.out { background: var(--crit-bg); color: var(--down); }
.pill.idle { background: var(--raised); color: var(--ink-2); }

/* tabs (no script needed) */
.tabs { margin-top: 28px; }
.tabs > input { position: absolute; opacity: 0; pointer-events: none; }
.tabbar { display: flex; gap: 4px; overflow-x: auto; border-bottom: 1px solid var(--grid); scrollbar-width: none; }
.tabbar label { padding: 9px 14px; font-size: 14px; color: var(--ink-2); cursor: pointer; white-space: nowrap;
  border-bottom: 2px solid transparent; margin-bottom: -1px; }
.tabbar label .c { color: var(--muted); font-size: 12px; margin-left: 4px; }
.panel-tab { display: none; padding-top: 16px; }
#t-gems:checked ~ .tabbar label[for="t-gems"], #t-coins:checked ~ .tabbar label[for="t-coins"],
#t-acc:checked ~ .tabbar label[for="t-acc"], #t-news:checked ~ .tabbar label[for="t-news"],
#t-src:checked ~ .tabbar label[for="t-src"] { color: var(--ink); border-bottom-color: var(--ink); font-weight: 600; }
#t-gems:checked ~ #p-gems, #t-coins:checked ~ #p-coins, #t-acc:checked ~ #p-acc,
#t-news:checked ~ #p-news, #t-src:checked ~ #p-src { display: block; }
.tabs > input:focus-visible ~ .tabbar { outline: 2px solid var(--bar); outline-offset: 2px; }

/* gem cards */
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
@media (max-width: 380px) { .cards { grid-template-columns: 1fr; } }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px; min-width: 0; }
.card .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
.card .sym { font-size: 17px; font-weight: 650; }
.card .meta { color: var(--muted); font-size: 12px; }
.spark { width: 100%; height: auto; display: block; margin: 10px 0 4px; }
.spark .lvl { font-size: 10px; fill: var(--ink-2); font-family: inherit; }
.trade { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 14px; margin-top: 6px; }
.trade td { padding: 4px 0; border-bottom: 1px solid var(--grid); }
.trade td:nth-child(2), .trade td:nth-child(3) { text-align: right; }
.trade td:nth-child(3) { width: 56px; color: var(--muted); font-size: 13px; }
.trade tr:last-child td { border-bottom: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.chip { font-size: 12px; padding: 2px 8px; border-radius: 6px; background: var(--raised); color: var(--ink-2); }
details { margin-top: 10px; }
details summary { cursor: pointer; font-size: 13px; color: var(--ink-2); list-style: none; }
details summary::-webkit-details-marker { display: none; }
details summary::before { content: "▸ "; }
details[open] summary::before { content: "▾ "; }
details .body { font-size: 13px; color: var(--ink-2); padding-top: 6px; }
details .body ul { margin: 4px 0 8px; padding-left: 18px; }
details .body h4 { margin: 8px 0 2px; font-size: 13px; color: var(--ink); }

/* tables */
.tbl { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow-x: auto; }
table.data { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 14px; }
table.data th, table.data td { padding: 9px 12px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--grid); }
table.data th { color: var(--ink-2); font-weight: 500; font-size: 12px; }
table.data th:first-child, table.data td:first-child, table.data .l { text-align: left; }
table.data tr:last-child td { border-bottom: 0; }
.bar { display: inline-flex; align-items: center; gap: 8px; }
.track { width: 70px; height: 6px; background: var(--track); border-radius: 3px; overflow: hidden; }
.fill { height: 100%; background: var(--bar); border-radius: 0 3px 3px 0; display: block; }

.posts { list-style: none; margin: 0; padding: 0; }
.posts li { padding: 11px 14px; border-bottom: 1px solid var(--grid); font-size: 14px; }
.posts li:last-child { border-bottom: 0; }
.posts .meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.posts a { color: inherit; }
.note { font-size: 12px; color: var(--muted); margin-top: 28px; }
.banner { background: var(--warn-bg); border-radius: 10px; padding: 10px 14px; font-size: 14px; margin-bottom: 14px; }
</style>
</head>
<body>
<main>
{% macro status_pill(st) -%}
  {%- if st == 'Enter zone' -%}<span class="pill go">● Buy now</span>
  {%- elif st == 'Wait for pullback' -%}<span class="pill wait">◆ Wait for dip</span>
  {%- elif st == 'Watch for breakout' -%}<span class="pill wait">◆ Watch breakout</span>
  {%- elif st in ['Exit signal', 'Take profit'] -%}<span class="pill out">▼ {{ 'Exit' if st == 'Exit signal' else 'Take profit' }}</span>
  {%- else -%}<span class="pill idle">○ {{ st }}</span>{%- endif -%}
{%- endmacro %}
{% macro pct(a, b) -%}{{ '%+.0f%%'|format((a / b - 1) * 100) if b else '' }}{%- endmacro %}

  {% if demo %}<div class="banner"><b>Preview with made-up data.</b> Prices, posts and ideas are invented to show the layout.</div>{% endif %}
  <h1>Crypto Signals</h1>
  <p class="sub">Spot ideas for {{ exchange|title }} · updated {{ generated_label }} UTC · next around {{ next_label }} UTC</p>

  {% set gems = emerging.tokens if emerging else [] %}
  {% set safe = gems|selectattr('safe')|list %}
  {% set buys = safe|selectattr('plan.status', 'in', ['Enter zone', 'Wait for pullback'])|list %}
  {% set held = (emerging.history if emerging and emerging.history else [])|selectattr('status', 'in', ['open'])|map(attribute='symbol')|list %}
  {% set exits = safe|selectattr('plan.status', 'in', ['Exit signal', 'Take profit'])|list %}
  {% set btc = coins|selectattr('coin', 'equalto', 'BTC')|first %}
  {% set bt = backtest.default.test if backtest else none %}

  <div class="strip">
    <div class="stat"><div class="k">Market</div>
      {% if fng %}<div class="v">{{ fng.value }} <span class="small muted" style="font-weight:400">{{ fng.label }}</span></div>{% else %}<div class="v">–</div>{% endif %}
      <div class="n">{% if btc %}Bitcoin <span class="{{ 'up' if btc.change_24h > 0 else 'down' }}">{{ '%+.1f'|format(btc.change_24h) }}%</span> today · {% endif %}mood {{ '%+.2f'|format(mood.score) }}</div></div>
    <div class="stat"><div class="k">Buy setups</div>
      <div class="v">{{ buys|length + suggestions|length }}</div>
      <div class="n">{{ safe|length }} safe gems · {{ coins|length }} coins scanned</div></div>
    <div class="stat"><div class="k">Exit signals</div>
      <div class="v {{ 'down' if exits else '' }}">{{ exits|length }}</div>
      <div class="n">on safe gems{% if held %} · {{ held|length }} picks running{% endif %}</div></div>
    <div class="stat"><div class="k">Gem rules, last 90 days</div>
      {% if bt and bt.trades %}<div class="v {{ 'up' if bt.avg_r > 0 else 'down' }}">{{ '%+.2f'|format(bt.avg_r) }}R</div>
      <div class="n">per trade · {{ bt.win_rate }}% won · {{ 'edge found' if bt.avg_r > 0 else 'no edge yet' }}</div>
      {% else %}<div class="v">–</div><div class="n">runs every Sunday</div>{% endif %}</div>
  </div>

  {% if trend %}{% set tt = trend.tested %}
  <h2>Core signal: Bitcoin &amp; Ethereum trend <span class="pill go" style="vertical-align:2px">✓ Tested</span></h2>
  <div class="cards">
    {% for coin, d in trend.coins.items() %}
    <article class="card">
      <div class="top">
        <div><div class="sym">{{ coin }}</div><div class="meta">{{ d.votes_on }} of {{ d.votes }} trend checks up · close {{ fp(d.close) }} on {{ d.as_of }}</div></div>
        {% if d.target > 0 %}<span class="pill go">● Hold {{ '%.0f'|format(d.target * 100) }}%</span>{% else %}<span class="pill idle">○ Out</span>{% endif %}
      </div>
      {{ spark(d.spark, {'add': d.next_add, 'trim': d.next_trim, 'exit': d.full_exit}, '90 days') }}
      <table class="trade">
        <tr><td>Position</td><td>{{ '%.0f'|format(d.target * 100) }}% · {{ '{:,.0f}'.format(d.target * trend.account) }} USDT</td><td></td></tr>
        {% if d.next_add %}<tr><td>Add more above</td><td class="up">{{ fp(d.next_add) }}</td><td>{{ pct(d.next_add, d.close) }}</td></tr>{% endif %}
        {% if d.next_trim %}<tr><td>Sell some below</td><td>{{ fp(d.next_trim) }}</td><td>{{ pct(d.next_trim, d.close) }}</td></tr>{% endif %}
        {% if d.full_exit %}<tr><td>Sell all below</td><td class="down">{{ fp(d.full_exit) }}</td><td>{{ pct(d.full_exit, d.close) }}</td></tr>{% endif %}
      </table>
    </article>
    {% endfor %}
    {% if tt %}<article class="card">
      <div class="sym" style="font-size:15px">How it tested</div>
      <div class="meta">{{ tt.data }}</div>
      <table class="trade">
        <tr><td class="muted small">gain · worst drop</td><td>Trend rule</td><td style="width:auto">Hold BTC</td></tr>
        {% for p in tt.periods %}<tr><td>{{ p.name }}</td><td><span class="{{ 'up' if p.trend.total > 0 else 'down' }}">{{ '%+.0f'|format(p.trend.total) }}%</span> · {{ '%.0f'|format(p.trend.max_dd) }}%</td><td style="width:auto"><span class="{{ 'up' if p.btc.total > 0 else 'down' }}">{{ '%+.0f'|format(p.btc.total) }}%</span> · {{ '%.0f'|format(p.btc.max_dd) }}%</td></tr>{% endfor %}
        <tr><td>Live since {{ trend.live.start }}</td><td>{{ '%+.1f'|format(trend.live.total) }}%</td><td style="width:auto">{{ trend.live.days }} days</td></tr>
      </table>
      <details><summary>How the rule works</summary><div class="body">
        <p style="margin:4px 0">Eight checks per coin look at whether price is making new highs over 10 to 360 days. Each check that's "up" adds to the position, and each has a trailing stop that only rises. Positions shrink when a coin is very jumpy, so a crash costs less. Decided on the daily close, traded at the next open, fees included.</p>
        <p style="margin:4px 0">It makes less than holding in strong bull markets (2023-24) and avoids most of the big crashes (2018, 2022). From published research (Zarattini et al. 2025), with their settings, not tuned to our data.</p>
        <h4>Year by year</h4><ul>{% for y in tt.by_year %}<li>{{ y.year }}: trend {{ '%+.0f'|format(y.trend or 0) }}%, Bitcoin {{ '%+.0f'|format(y.btc or 0) }}%</li>{% endfor %}</ul>
      </div></details>
    </article>{% endif %}
  </div>
  {% if trend.guard and not trend.guard.buys_allowed %}<div class="banner" style="margin-top:12px">⏸ <b>New buys are paused.</b> {{ trend.guard.reasons|join('; ') }}. Sell signals still apply.</div>{% endif %}
  {% if trend.alts %}{% set al = trend.alts %}{% set held_alts = al.coins.items()|selectattr('1.target')|sort(attribute='1.target', reverse=True)|list %}
  <h2>Altcoin trend portion <span class="small muted" style="font-weight:400">25% of the account · {{ '%.0f'|format(al.total * 100) }}% invested now</span></h2>
  <div class="tbl"><table class="data">
    <thead><tr><th>Coin</th><th>Hold</th><th>USDT</th><th>Close</th><th>Sell all below</th><th>Trend checks</th></tr></thead><tbody>
    {% for c, d in held_alts %}<tr><td><b>{{ c }}</b></td><td>{{ '%.1f'|format(d.target * 100) }}%</td><td>{{ '{:,.0f}'.format(d.target * trend.account) }}</td><td>{{ fp(d.close) }}</td><td class="down">{{ fp(d.full_exit) if d.full_exit else '–' }}</td><td>{{ d.votes_on }}/8</td></tr>
    {% else %}<tr><td class="l" colspan="6">No altcoin held right now: {{ 'Bitcoin is below its 200-day average' if not al.gate else 'none is in an uptrend' }}.</td></tr>{% endfor %}
  </tbody></table></div>
  <p class="small muted">Top 20 altcoins by volume, sized by trend strength and calmness. In cash when Bitcoin is below its 200-day average{% if al.funding_hot %}; <b>halved now</b> because traders pay a lot to be long{% else %}; halved when traders pay a lot to be long{% endif %}. Live since {{ al.live.start }}: {{ '%+.1f'|format(al.live.total) }}%.</p>
  {% endif %}
  {% endif %}

  <h2>Watchlist ideas <span class="small muted" style="font-weight:400">not proven by testing, so check before acting</span></h2>
  <div class="actions">
    {% for a in suggestions %}{% set s = a.suggestion %}
    <div class="act"><span class="pill go">● Buy</span>
      <div class="what"><b>{{ a.coin }}</b> <span class="muted small">main coin · score {{ '%.0f'|format(a.score) }}</span></div>
      <div class="lv">buy {{ fp(s.entry) }} · stop {{ fp(s.stop) }}</div></div>
    {% endfor %}
    {% for t in buys %}{% set p = t.plan %}
    <div class="act">{{ status_pill(p.status) }}
      <div class="what"><b>{{ t.symbol }}</b> <span class="muted small">{{ t.narrative }} · risk {{ t.risk_rating|lower }}</span></div>
      <div class="lv">{{ 'buy' if p.status == 'Enter zone' else 'limit' }} {{ fp(p.entry) }} · stop {{ fp(p.stop) }}</div></div>
    {% endfor %}
    {% for t in exits %}
    <div class="act">{{ status_pill(t.plan.status) }}
      <div class="what"><b>{{ t.symbol }}</b> <span class="muted small">{{ 'you hold this pick: ' if t.symbol in held else 'if you hold it: ' }}{{ 'sell' if t.plan.status == 'Exit signal' else 'sell some' }}</span></div>
      <div class="lv">now {{ fp(t.plan.price) }}</div></div>
    {% endfor %}
    {% if not suggestions and not buys and not exits %}<div class="empty">Nothing to do right now. No safe setup at a good level. Sitting out is a position too.</div>{% endif %}
  </div>
  {% if bt and bt.trades and bt.avg_r <= 0 %}<p class="small muted" style="margin-top:8px">The buy rules haven't made money in recent backtests, so treat these as a watchlist, not trades.</p>{% endif %}

  <div class="tabs">
    <input type="radio" name="tab" id="t-gems" checked>
    <input type="radio" name="tab" id="t-coins">
    <input type="radio" name="tab" id="t-acc">
    <input type="radio" name="tab" id="t-news">
    <input type="radio" name="tab" id="t-src">
    <div class="tabbar" role="tablist">
      <label for="t-gems">Hidden gems (watchlist)<span class="c">{{ safe|length }}</span></label>
      <label for="t-coins">Main coins<span class="c">{{ coins|length }}</span></label>
      <label for="t-acc">Accuracy</label>
      <label for="t-news">News &amp; traders<span class="c">{{ top_posts|length }}</span></label>
      <label for="t-src">Data sources</label>
    </div>

    <!-- GEMS -->
    <section class="panel-tab" id="p-gems">
      {% if emerging %}
      <p class="small muted" style="margin:0 0 12px">Small tokens from every sector that passed the safety checks. Picked {{ (emerging.as_of or '')[:16]|replace('T', ' ') }} UTC; prices refresh every 4 hours.
        {% if emerging.hot %}Rising sectors today: {% for h in emerging.hot[:4] %}{{ h.name }} <span class="{{ 'up' if h.change_24h > 0 else 'down' }}">{{ '%+.1f'|format(h.change_24h) }}%</span>{{ ', ' if not loop.last }}{% endfor %}.{% endif %}</p>
      {% if safe %}
      <div class="cards">
        {% for t in safe %}{% set p = t.plan %}{% set why = p.why or {} %}
        <article class="card">
          <div class="top">
            <div><div class="sym">{{ t.symbol }}</div>
              <div class="meta">{{ t.name }} · {{ t.narrative }} · ${{ '{:,.0f}'.format((t.market_cap or 0) / 1e6) }}M</div></div>
            {{ status_pill(p.status) }}
          </div>
          {{ spark(t.spark, p) }}
          {% if p.entry is defined %}
          <table class="trade">
            <tr><td>{{ 'Buy now' if p.status == 'Enter zone' else 'Buy limit' }}</td><td>{{ fp(p.entry) }}</td><td>{{ pct(p.entry, p.price) }}</td></tr>
            <tr><td>Stop-loss</td><td class="down">{{ fp(p.stop) }}</td><td>{{ pct(p.stop, p.entry) }}</td></tr>
            <tr><td>Sell half</td><td class="up">{{ fp(p.tp1) }}</td><td>{{ pct(p.tp1, p.entry) }}</td></tr>
            <tr><td>Sell rest</td><td class="up">{{ fp(p.tp2) }}</td><td>{{ pct(p.tp2, p.entry) }}</td></tr>
            <tr><td>Size</td><td>{{ '{:,.0f}'.format(p.notional) }} USDT</td><td>−{{ '{:,.0f}'.format(p.max_loss) }}</td></tr>
          </table>
          {% else %}
          <p class="small" style="margin:6px 0 0">{{ p.action }}</p>
          {% endif %}
          {% set passed = t.safety|selectattr('ok')|list|length %}
          <div class="chips">
            <span class="chip">🛡 {{ passed }}/{{ t.safety|length }} checks</span>
            <span class="chip">Risk {{ t.risk_rating|lower }}</span>
            <span class="chip">Score {{ '%.0f'|format(t.potential) }}</span>
            {% if t.change_7d is not none %}<span class="chip">7d {{ '%+.0f'|format(t.change_7d) }}%</span>{% endif %}
          </div>
          <details><summary>Why, checks and risks</summary>
            <div class="body">
              {% if p.entry is defined %}<p style="margin:4px 0">{{ p.action }}</p>
              {% if why %}<h4>Why these levels</h4><ul>
                <li>Buy: {{ why.entry }}</li><li>Stop: {{ why.stop }}</li><li>Sell half: {{ why.tp1 }}</li><li>Sell rest: {{ why.tp2 }}</li></ul>{% endif %}
              <h4>When to leave</h4><p style="margin:2px 0">{{ p.exit_rule }}</p>{% endif %}
              <h4>Safety checks</h4><ul>
                {% for c in t.safety %}<li>{{ '✅' if c.ok else ('❌' if c.ok is sameas false else '❔') }} {{ c.name }}: {{ c.detail }}</li>{% endfor %}</ul>
              {% if t.risk_notes %}<h4>Risks</h4><ul>{% for r in t.risk_notes %}<li>{{ r }}</li>{% endfor %}</ul>{% endif %}
              {% if t.potential_notes %}<h4>Context, not a reason to buy</h4><ul>{% for n in t.potential_notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
            </div>
          </details>
        </article>
        {% endfor %}
      </div>
      {% else %}<div class="actions"><div class="empty">No token passed every safety check in this morning's scan.</div></div>{% endif %}
      {% set bad = gems|rejectattr('safe')|list %}
      {% if bad %}
      <details><summary>{{ bad|length }} token{{ 's' if bad|length != 1 }} failed the safety checks</summary>
        <div class="body"><ul>{% for t in bad %}<li><b>{{ t.symbol }}</b>: {{ t.failed_checks|join(', ')|lower }}</li>{% endfor %}</ul></div>
      </details>
      {% endif %}
      {% else %}<div class="actions"><div class="empty">Waiting for the first morning scan.</div></div>{% endif %}
    </section>

    <!-- MAIN COINS -->
    <section class="panel-tab" id="p-coins">
      <div class="tbl"><table class="data">
        <thead><tr><th>Coin</th><th>Price</th><th>24h</th><th>Score</th><th class="l">Signal</th><th>Sentiment</th></tr></thead>
        <tbody>
        {% for a in coins %}
          <tr title="trend {{ a.components.trend }} · momentum {{ a.components.momentum }} · sentiment {{ a.components.sentiment }} · positioning {{ a.components.positioning }} · low volatility {{ a.components.risk }} · RSI {{ a.rsi }}">
            <td><b>{{ a.coin }}</b></td>
            <td>{{ fp(a.price) }}</td>
            <td class="{{ 'up' if a.change_24h > 0 else 'down' }}">{{ '%+.1f'|format(a.change_24h) }}%</td>
            <td><span class="bar"><span class="track"><span class="fill" style="width:{{ [[a.score, 0]|max, 100]|min }}%"></span></span>{{ '%.0f'|format(a.score) }}</span></td>
            <td class="l">{% if a.label == 'Bullish' %}<span class="pill go">▲ Bullish</span>{% elif a.label == 'Weak' %}<span class="pill out">▼ Weak</span>{% else %}<span class="pill idle">● Neutral</span>{% endif %}</td>
            <td class="{{ 'up' if a.sentiment.score > 0.05 else ('down' if a.sentiment.score < -0.05 else '') }}">{{ '%+.2f'|format(a.sentiment.score) }} <span class="muted small">({{ a.sentiment.mentions }})</span></td>
          </tr>
        {% endfor %}
        </tbody>
      </table></div>
      <p class="small muted">Hover a row for the score's parts. A coin becomes a buy idea at 65+ with an uptrend. Sentiment shows the post count in brackets.</p>
      {% if history %}
      <details><summary>Past main-coin ideas ({{ history|length }})</summary><div class="body">
        <div class="tbl"><table class="data"><thead><tr><th>Coin</th><th>Date</th><th>Entry</th><th>Stop</th><th class="l">Status</th><th>Result</th></tr></thead><tbody>
        {% for h in history %}<tr><td><b>{{ h.coin }}</b></td><td>{{ h.created[:10] }}</td><td>{{ fp(h.entry) }}</td><td>{{ fp(h.stop) }}</td><td class="l">{{ h.status }}</td>
          <td>{{ ('%+.1fR'|format(h.result_r)) if h.result_r is defined else '–' }}</td></tr>{% endfor %}
        </tbody></table></div></div></details>
      {% endif %}
    </section>

    <!-- ACCURACY -->
    <section class="panel-tab" id="p-acc">
      {% set gr = emerging.record if emerging and emerging.record else none %}
      <div class="strip" style="margin-top:0">
        <div class="stat"><div class="k">Gem picks, real results</div>
          {% if gr and gr.closed %}<div class="v {{ 'up' if gr.avg_r > 0 else 'down' }}">{{ '%+.2f'|format(gr.avg_r) }}R</div><div class="n">{{ gr.win_rate }}% won · {{ gr.closed }} finished</div>
          {% else %}<div class="v">–</div><div class="n">{{ gr.open if gr else 0 }} running, none finished yet</div>{% endif %}</div>
        {% if backtest %}{% set tr = backtest.default.train %}{% set sm = backtest.default.small_coins %}
        <div class="stat"><div class="k">Backtest, last {{ backtest.test_days }} days</div>
          {% if bt.trades %}<div class="v {{ 'up' if bt.avg_r > 0 else 'down' }}">{{ '%+.2f'|format(bt.avg_r) }}R</div><div class="n">{{ bt.win_rate }}% won · {{ bt.trades }} trades</div>{% else %}<div class="v">–</div>{% endif %}</div>
        <div class="stat"><div class="k">Backtest, earlier months</div>
          {% if tr.trades %}<div class="v {{ 'up' if tr.avg_r > 0 else 'down' }}">{{ '%+.2f'|format(tr.avg_r) }}R</div><div class="n">{{ tr.win_rate }}% won · {{ tr.trades }} trades</div>{% else %}<div class="v">–</div>{% endif %}</div>
        <div class="stat"><div class="k">Settings</div>
          <div class="v" style="font-size:17px">{{ 'Tuned' if backtest.choice.adopted else 'Default' }}</div><div class="n">{{ backtest.choice.reason }}</div></div>
        {% endif %}
      </div>
      <p class="small muted">"R" is the amount risked: +1R means you made what you risked, −1R means the stop was hit. Fees included.
        {% if backtest %}The backtest replays the buy and sell rules on {{ backtest.coins }} Bitget coins and tries {{ backtest.best|length and '144' or '' }} setting variations every Sunday; a variation is only used if it also wins on the most recent months. Last run {{ backtest.generated_at[:16]|replace('T', ' ') }} UTC.{% endif %}</p>
      {% if backtest and backtest.best %}
      <details><summary>Best variations tried</summary><div class="body">
        <div class="tbl"><table class="data"><thead><tr><th>Stop</th><th>Targets</th><th>Trend min</th><th>BTC filter</th><th>Early exit</th><th>Earlier</th><th>Recent</th></tr></thead><tbody>
        {% for v in backtest.best %}{% set q = v.params %}<tr><td>{{ q.stop_atr }}× ATR</td><td>{{ q.tp1_r }}R / {{ q.tp2_r }}R</td><td>{{ q.trend_min }}</td><td>{{ 'yes' if q.btc_filter else 'no' }}</td><td>{{ 'yes' if q.exit_on_ema20 else 'no' }}</td>
          <td class="{{ 'up' if v.train.avg_r > 0 else 'down' }}">{{ '%+.2f'|format(v.train.avg_r) }}R</td><td class="{{ 'up' if (v.test.avg_r or 0) > 0 else 'down' }}">{{ ('%+.2f'|format(v.test.avg_r)) if v.test.trades else '–' }}R</td></tr>{% endfor %}
        </tbody></table></div></div></details>
      {% endif %}
      {% if emerging and emerging.history %}
      <h2>Gem picks so far</h2>
      <div class="tbl"><table class="data">
        <thead><tr><th>Gem</th><th>Picked</th><th>Entry</th><th>Stop</th><th class="l">Status</th><th>Result</th></tr></thead><tbody>
        {% for h in emerging.history %}{% set rr = h.result_r if h.result_r is defined else (h.unrealized_r if h.unrealized_r is defined else none) %}
        <tr><td><b>{{ h.symbol }}</b></td><td>{{ h.created[5:16]|replace('T', ' ') }}</td><td>{{ fp(h.entry) }}</td><td>{{ fp(h.stop) }}</td><td class="l">{{ h.status }}</td>
          <td class="{{ 'up' if (rr or 0) > 0 else ('down' if (rr or 0) < 0 else '') }}">{% if rr is not none %}{{ '%+.2fR'|format(rr) }}{% if h.result_r is not defined %} <span class="muted small">so far</span>{% endif %}{% else %}–{% endif %}</td></tr>
        {% endfor %}
      </tbody></table></div>
      {% endif %}
    </section>

    <!-- NEWS -->
    <section class="panel-tab" id="p-news">
      <div class="actions">
        {% if top_posts %}
        <ul class="posts">
          {% for p in top_posts[:12] %}
          <li><div>{{ p.text|truncate(220) }}</div>
            <div class="meta">{{ p.author }} · {{ p.ts[11:16] }} UTC ·
              <span class="{{ 'up' if p.sentiment > 0.05 else ('down' if p.sentiment < -0.05 else '') }}">{{ 'bullish' if p.sentiment > 0.05 else ('bearish' if p.sentiment < -0.05 else 'neutral') }} {{ '%+.2f'|format(p.sentiment) }}</span>
              {% if p.coins %}· {{ p.coins|join(', ') }}{% endif %}
              {% if p.url|safe_url %}· <a href="{{ p.url|safe_url }}" rel="noopener noreferrer" target="_blank">open</a>{% endif %}</div></li>
          {% endfor %}
        </ul>
        {% else %}<div class="empty">No posts collected in this window.</div>{% endif %}
      </div>
      <p class="small muted">Social mood {{ '%+.2f'|format(mood.score) }} across {{ mood.mentions }} posts in the last {{ lookback }} hours, read by the CryptoBERT AI model.</p>
    </section>

    <!-- SOURCES -->
    <section class="panel-tab" id="p-src">
      <div class="tbl"><table class="data"><tbody>
        {% for name, status in health.items() %}<tr><td class="l">{{ name }}</td><td class="l {{ 'down' if status.startswith('failed') else '' }}">{{ status }}</td></tr>{% endfor %}
        {% if trending %}<tr><td class="l">Trending on CoinGecko</td><td class="l">{{ trending|join(', ') }}</td></tr>{% endif %}
      </tbody></table></div>
    </section>
  </div>

  <p class="note">Ideas only, not financial advice. The bot never places trades. Spot only: crypto futures are not available to UK retail traders.</p>
</main>
</body>
</html>
